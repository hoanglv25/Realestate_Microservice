# =============================================================================
# .env.example - mẫu biến môi trường. Sao chép thành .env (KHÔNG commit .env).
#   PowerShell: Copy-Item .env.example .env
# Giá trị mẫu chỉ dùng cho dev/demo trên máy local. KHÔNG đặt bí mật thật ở đây.
# Quy ước: không dùng dấu cách, dấu nháy hay ký tự đặc biệt trong giá trị để
# docker compose và NestJS đọc giống nhau.
#
# HAI CÁCH KẾT NỐI HẠ TẦNG (quan trọng):
#   1) Tiến trình chạy TRỰC TIẾP trên laptop (pnpm start:dev, psql, DBeaver...):
#      dùng <HOST>=localhost và cổng đã publish (POSTGRES_PORT=5433, ...).
#   2) Service chạy TRONG Docker (cùng network realestate-net): dùng tên host
#      container (postgres, redis, rabbitmq) và cổng nội bộ
#      (Postgres 5432, Redis 6379, RabbitMQ 5672).
# =============================================================================

# ---------- Chung ----------
# Môi trường chạy: development | production | test
NODE_ENV=development
# Mức log: debug | info | warn | error
LOG_LEVEL=debug

# ---------- Cổng các service (chạy trên laptop) ----------
# api-gateway: điểm vào duy nhất cho client
GATEWAY_PORT=8080
# identity-service: đăng ký/đăng nhập, phát hành JWT
IDENTITY_PORT=3001
# listing-service: tin đăng phòng, tìm kiếm
LISTING_PORT=3002
# rental-service: đặt lịch xem, giữ chỗ, hợp đồng thuê
RENTAL_PORT=3003
# payment-service: ví trung gian, đặt cọc, rút tiền
PAYMENT_PORT=3004
# notification-service: thông báo
NOTIFICATION_PORT=3005
# assistant-service: chatbot gợi ý phòng
ASSISTANT_PORT=3006

# ---------- PostgreSQL (1 instance, 5 DB riêng) ----------
# Host cho tiến trình chạy trên laptop. Service trong Docker dùng POSTGRES_DOCKER_HOST.
POSTGRES_HOST=localhost
# Cổng publish ra laptop (127.0.0.1:5433 -> container 5432). Dùng 5433 vì máy đã cài
# PostgreSQL trên Windows chiếm 5432. Chỉ áp dụng cho tiến trình chạy trên laptop.
POSTGRES_PORT=5433
# Host cho service chạy trong Docker (tên container trên network chung)
POSTGRES_DOCKER_HOST=postgres
# Cổng nội bộ của container Postgres (luôn 5432, không đổi theo POSTGRES_PORT)
POSTGRES_DOCKER_PORT=5432
# Tài khoản superuser, chỉ dùng để chạy script khởi tạo DB
POSTGRES_SUPERUSER=postgres
# Mật khẩu superuser (mẫu)
POSTGRES_SUPERUSER_PASSWORD=change_me_pg_superuser
# DB mặc định của superuser
POSTGRES_DEFAULT_DB=postgres

# identity_db
IDENTITY_DB_NAME=identity_db
# User riêng chỉ vào được identity_db
IDENTITY_DB_USER=identity_user
# Mật khẩu user identity (mẫu)
IDENTITY_DB_PASSWORD=change_me_identity

# listing_db (bật extension postgis)
LISTING_DB_NAME=listing_db
# User riêng chỉ vào được listing_db
LISTING_DB_USER=listing_user
# Mật khẩu user listing (mẫu)
LISTING_DB_PASSWORD=change_me_listing

# rental_db
RENTAL_DB_NAME=rental_db
# User riêng chỉ vào được rental_db
RENTAL_DB_USER=rental_user
# Mật khẩu user rental (mẫu)
RENTAL_DB_PASSWORD=change_me_rental

# payment_db
PAYMENT_DB_NAME=payment_db
# User riêng chỉ vào được payment_db
PAYMENT_DB_USER=payment_user
# Mật khẩu user payment (mẫu)
PAYMENT_DB_PASSWORD=change_me_payment

# notification_db (thay MongoDB, xem docs/adr/ADR-008)
NOTIFICATION_DB_NAME=notification_db
# User riêng chỉ vào được notification_db
NOTIFICATION_DB_USER=notification_user
# Mật khẩu user notification (mẫu)
NOTIFICATION_DB_PASSWORD=change_me_notification

# ---------- Redis ----------
# Host cho tiến trình chạy trên laptop (trong Docker: redis)
REDIS_HOST=localhost
# Cổng Redis publish ra laptop (container lắng nghe 6379)
REDIS_PORT=6379
# Mật khẩu Redis (mẫu)
REDIS_PASSWORD=change_me_redis

# ---------- RabbitMQ ----------
# Host cho tiến trình chạy trên laptop (trong Docker: rabbitmq)
RABBITMQ_HOST=localhost
# Cổng AMQP publish ra laptop (container lắng nghe 5672)
RABBITMQ_PORT=5672
# Cổng giao diện Management UI publish ra laptop (container lắng nghe 15672)
RABBITMQ_MANAGEMENT_PORT=15672
# Tài khoản RabbitMQ (mẫu)
RABBITMQ_USER=rabbit_admin
# Mật khẩu RabbitMQ (mẫu)
RABBITMQ_PASSWORD=change_me_rabbitmq
# Virtual host
RABBITMQ_VHOST=/
# Exchange sự kiện domain (topic, durable)
RABBITMQ_EXCHANGE=domain.events

# ---------- Object storage S3: Cloudflare R2 (project-knowledge/decisions/0016) ----------
# Không có container: R2 là dịch vụ ngoài, dev và production dùng chung tài khoản tới go-live.
# Khóa THẬT chỉ để ở .env (không commit). Token R2 quyền Object Read & Write trên các bucket dưới.
# Endpoint S3 API của tài khoản (dashboard R2 > Account Details > S3 API, bỏ phần /tên-bucket)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2 dùng region "auto"
S3_REGION=auto
# Access Key ID của token R2
S3_ACCESS_KEY=ACCESS_KEY_ID
# Secret Access Key của token R2 (chỉ hiện một lần khi tạo token)
S3_SECRET_KEY=SECRET_ACCESS_KEY
# Dạng endpoint/bucket; R2 chạy được với true
S3_FORCE_PATH_STYLE=true
# Bucket CÓ SẴN (tạo tay trên dashboard R2; service không tự tạo bucket)
# Bucket ảnh tin đăng (listing-service, CORS cho origin giao diện: GET, PUT, HEAD)
S3_BUCKET_LISTING_IMAGES=listing-images
# Bucket ảnh QR ngân hàng (payment-service, chưa dùng)
S3_BUCKET_BANK_QR=bank-qr
# Bucket chứng từ thanh toán (payment-service)
S3_BUCKET_PAYMENT_PROOFS=payment-proofs
# Bucket giấy tờ người thuê (rental-service, chưa dùng)
S3_BUCKET_TENANT_DOCS=tenant-docs
# Bucket riêng cho test hạ tầng (storage.infra-spec.ts; ảnh của listing-crud dùng S3_* ở trên).
# Để trống thì các test cần S3 tự bỏ qua. Đã điền khóa R2 thật thì đặt: S3_TEST_BUCKET=infra-test
S3_TEST_BUCKET=

# ---------- Elasticsearch / Kibana (chỉ profile demo) ----------
# Cổng Kibana publish ra laptop (container lắng nghe 5601)
KIBANA_PORT=5601

# ---------- Địa chỉ service nội bộ (gọi HTTP giữa các service) ----------
# Chạy service trên laptop dùng localhost. Profile apps (Docker) KHÔNG đọc các biến này:
# docker-compose.yml tự đặt tên service (http://identity:3001...).
INTERNAL_IDENTITY_URL=http://localhost:3001
# URL nội bộ listing-service
INTERNAL_LISTING_URL=http://localhost:3002
# URL nội bộ rental-service
INTERNAL_RENTAL_URL=http://localhost:3003
# URL nội bộ payment-service
INTERNAL_PAYMENT_URL=http://localhost:3004
# URL nội bộ notification-service
INTERNAL_NOTIFICATION_URL=http://localhost:3005
# URL nội bộ assistant-service
INTERNAL_ASSISTANT_URL=http://localhost:3006

# Timeout gọi HTTP nội bộ (ms)
HTTP_TIMEOUT_MS=3000
# Số lần thử lại khi gọi HTTP nội bộ thất bại
HTTP_MAX_RETRIES=2

# ---------- rental: đặt cọc (RE.DEPOSIT_SAGA/API_Spec.md §5, RE.DEPOSIT_LIFECYCLE §6) ----------
# Bỏ 4 biến của luồng cũ (DEPOSIT_PAYMENT_TTL_SECONDS, RESERVATION_TTL_SECONDS, PAYMENT_CLAIM_TTL_SECONDS,
# ADMIN_SLA_SECONDS) theo A3. Khi demo, đặt ngắn (ví dụ HOLD_TTL_SECONDS=60) để thấy hết hạn.
# Giữ chỗ (BR-07) = hạn link payOS: 10 phút
HOLD_TTL_SECONDS=600
# Khóa Redis theo tin trong lúc chạy saga (ms)
DEPOSIT_LOCK_TTL_MS=10000
# Timeout gọi listing, payment (ms). Tổng saga ≤ 8 giây (NFR07); PAYMENT_CALL_TIMEOUT_MS chốt sau khi đo E1, E2
LISTING_CALL_TIMEOUT_MS=2000
PAYMENT_CALL_TIMEOUT_MS=3000
# Sau khi PAID: hạn yêu cầu hoàn 48 giờ, tự giải ngân 72 giờ
REFUND_WINDOW_SECONDS=172800
AUTO_RELEASE_SECONDS=259200
# SagaReconcileJob (T3.3): chu kỳ (ms, 0 = tắt) và ngưỡng coi đơn chưa có order là kẹt (giây)
SAGA_RECONCILE_INTERVAL_MS=15000
SAGA_STUCK_AFTER_SECONDS=30
# HoldExpiryJob (T3.4b, BR-09): chu kỳ quét đơn quá hạn giữ chỗ (ms, 0 = tắt); E4 cần ≤ 10 giây
HOLD_EXPIRY_INTERVAL_MS=5000
# Vòng đời đơn (T3.5): nhắc trước tự giải ngân (giây, 24 giờ); chu kỳ AutoReleaseJob, DeadlineJob (ms, 0 = tắt)
RELEASE_REMINDER_SECONDS=86400
AUTO_RELEASE_INTERVAL_MS=10000
DEADLINE_INTERVAL_MS=10000

# ---------- JWT ----------
# Đường dẫn trên laptop. Profile apps (Docker) mount khóa qua `secrets:` của compose
# (/run/secrets/jwt_public_key, /run/secrets/jwt_private_key), không đọc hai biến dưới.
# Đường dẫn khóa công khai (RS256) để các service xác thực token
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
# Đường dẫn khóa riêng, chỉ identity-service dùng để ký token
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
# Thời hạn access token (giây): 15 phút
JWT_ACCESS_TTL_SECONDS=900
# Thời hạn refresh token (giây): 7 ngày
JWT_REFRESH_TTL_SECONDS=604800
# Issuer ghi trong token
JWT_ISSUER=realestate-identity

# ---------- identity: mã hóa số tài khoản nhận tiền ----------
# Khóa AES-256-GCM, base64 của đúng 32 byte. BẮT BUỘC với identity (thiếu hoặc sai thì identity dừng khi khởi động).
# File mẫu để TRỐNG: tự sinh MỘT lần rồi dán vào .env (không commit):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mất hoặc đổi khóa thì số tài khoản đã lưu không giải mã được (không có xoay khóa, security-policy.md §6).
BANK_ACCOUNT_ENCRYPTION_KEY=

# ---------- identity: email OTP, đặt lại mật khẩu, Google (RE.IDENTITY/API_Spec.md §5) ----------
# SMTP thật, không còn Mailpit (C27). Dev: Gmail của nhóm + App Password
# (bật Xác minh 2 bước, tạo ở https://myaccount.google.com/apppasswords, bỏ dấu cách).
# Dùng cho identity chạy trong Docker (profile apps); chạy `pnpm dev` thì điền services/identity/.env.
# Thiếu SMTP_HOST hoặc MAIL_FROM thì identity báo thiếu và dừng. 465 = TLS ngay; 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Địa chỉ Gmail gửi thư. SMTP_PASSWORD (App Password) chỉ nằm trong .env (security-policy.md §1)
SMTP_USER=
SMTP_PASSWORD=
# Nên trùng SMTP_USER, ví dụ "Real Estate <ten-gmail@gmail.com>" (Gmail tự thay nếu khác địa chỉ đăng nhập)
MAIL_FROM=
# OTP: hiệu lực 5 phút, sai 5 lần hủy, gửi lại sau 60 giây (Báo cáo Bảng 2.6)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Token đặt lại mật khẩu: 15 phút; PASSWORD_RESET_URL là trang Next.js nhận ?token=
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# aud của ID token Google. Để TRỐNG: identity vẫn chạy, POST /auth/google trả 503
GOOGLE_CLIENT_ID=

# ---------- payment: payOS (RE.PAYMENT/API_Spec.md §5) ----------
# Khóa môi trường THỬ NGHIỆM lấy ở trang quản trị payOS; giá trị thật chỉ ghi ở .env (security-policy.md §1).
# Để trống: payment báo thiếu và dừng khi khởi động.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trang Next.js sau khi thanh toán; returnUrl KHÔNG phải bằng chứng thanh toán
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
# Phải < PAYMENT_CALL_TIMEOUT_MS của rental (3000). Không retry lệnh tạo link
PAYOS_TIMEOUT_MS=2500

# ---------- payment: payout (RE.PAYOUT/API_Spec.md §6, T3.6) ----------
# Cỡ tối đa một tệp chứng từ chuyển khoản (byte), 5 MB. Loại nhận: image/jpeg, image/png, application/pdf
RECEIPT_MAX_BYTES=5242880

# ---------- api-gateway (RE.GATEWAY/API_Spec.md §5) ----------
# Timeout chuyển tiếp tới service đích (ms). PHẢI > 8000 (NFR07: ngân sách đặt cọc 8 giây)
GATEWAY_PROXY_TIMEOUT_MS=10000
# Cửa sổ rate limit (giây)
RATE_LIMIT_TTL_SECONDS=60
# Số request tối đa mỗi cửa sổ khi chưa đăng nhập (route public, webhook payOS): đếm theo IP
RATE_LIMIT_IP=100
# Số request tối đa mỗi cửa sổ khi đã đăng nhập: đếm theo sub trong token
RATE_LIMIT_USER=300
# Origin của giao diện Next.js được gọi từ trình duyệt, nhiều origin cách nhau dấu phẩy
CORS_ORIGINS=http://localhost:3000
