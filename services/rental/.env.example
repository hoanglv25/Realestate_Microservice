# =============================================================================
# .env.example của service. Sao chép thành .env (KHÔNG commit .env):
#   Copy-Item .env.example .env      (`pnpm dev` tự làm việc này nếu chưa có .env)
# Giá trị mẫu chỉ dùng cho dev local, khớp với giá trị mẫu của .env gốc repo.
# Thiếu biến bắt buộc (SERVICE_NAME) hoặc sai định dạng thì service dừng ngay khi khởi động.
# =============================================================================

# ---------- Tối thiểu (luôn cần) ----------
# Môi trường chạy: development | test | production
NODE_ENV=development
# Cổng HTTP của rental-service (khớp RENTAL_PORT trong .env gốc)
PORT=3003
# Tên service, xuất hiện trong log, /health và tài liệu Swagger (BẮT BUỘC, không có mặc định)
SERVICE_NAME=rental
# Mức log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# true: log màu dễ đọc bằng pino-pretty (chỉ dev); false: JSON một dòng ra stdout
LOG_PRETTY=false

# ---------- HTTP client gọi service khác ----------
# Timeout mỗi lần gọi (ms). Lưu ý: .env gốc ghi 5000, template mặc định 3000
HTTP_TIMEOUT_MS=3000
# Số lần thử lại tối đa (chỉ GET/lệnh idempotent)
HTTP_MAX_RETRIES=2

# ---------- Swagger / Idempotency ----------
# Bật Swagger ở /api/docs (nên tắt ở production)
SWAGGER_ENABLED=true
# Thời gian lưu kết quả Idempotency-Key trong Redis (giây): 24 giờ
IDEMPOTENCY_TTL_SECONDS=86400

# =============================================================================
# Cấu hình RIÊNG của rental-service (RE.DEPOSIT_SAGA/API_Spec.md §5, RE.DEPOSIT_LIFECYCLE §6)
# =============================================================================

# ---------- PostgreSQL (BẮT BUỘC) ----------
# Chạy migration một lần: pnpm --filter @realestate/rental migration:run
DATABASE_URL=postgres://rental_user:change_me_rental@localhost:5433/rental_db

# ---------- Redis (BẮT BUỘC): khóa theo tin khi đặt cọc + Idempotency-Key ----------
REDIS_URL=redis://:change_me_redis@localhost:6379

# ---------- RabbitMQ (BẮT BUỘC): phát rental.*, nghe queue rental.payment-events ----------
RABBITMQ_URL=amqp://rabbit_admin:change_me_rabbitmq@localhost:5672/
RABBITMQ_QUEUE=rental.payment-events

# ---------- Gọi service khác (BẮT BUỘC) ----------
INTERNAL_LISTING_URL=http://localhost:3002
INTERNAL_PAYMENT_URL=http://localhost:3004
# Timeout từng lời gọi (ms). Tổng saga phải ≤ 8 giây (NFR07). PAYMENT_CALL_TIMEOUT_MS chốt lại sau khi đo E1, E2
LISTING_CALL_TIMEOUT_MS=2000
PAYMENT_CALL_TIMEOUT_MS=3000

# ---------- Đặt cọc ----------
# Thời gian giữ chỗ (BR-07): 10 phút; demo rút xuống 60
HOLD_TTL_SECONDS=600
# Khóa Redis theo tin trong lúc chạy saga (ms)
DEPOSIT_LOCK_TTL_MS=10000
# Mốc sau khi PAID: hạn yêu cầu hoàn 48 giờ, tự giải ngân 72 giờ (demo rút xuống vài chục giây)
REFUND_WINDOW_SECONDS=172800
AUTO_RELEASE_SECONDS=259200

# ---------- JWT RS256 (BẮT BUỘC): rental chỉ KIỂM token ----------
JWT_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
JWT_ISSUER=realestate-identity
