# =============================================================================
# .env.example của service. Sao chép thành .env (KHÔNG commit .env):
#   Copy-Item .env.example .env      (`pnpm dev` tự làm việc này nếu chưa có .env)
# Giá trị mẫu chỉ dùng cho dev local, khớp với giá trị mẫu của .env gốc repo.
# Thiếu biến bắt buộc (SERVICE_NAME) hoặc sai định dạng thì service dừng ngay khi khởi động.
# =============================================================================

# ---------- Tối thiểu (luôn cần) ----------
# Môi trường chạy: development | test | production
NODE_ENV=development
# Cổng HTTP của service (template dùng 3000; service thật: identity 3001, listing 3002, ...)
PORT=3000
# Tên service, xuất hiện trong log, /health và tài liệu Swagger (BẮT BUỘC, không có mặc định)
SERVICE_NAME=template-nest
# Mức log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# true: log màu dễ đọc bằng pino-pretty (chỉ dev); false: JSON một dòng ra stdout
LOG_PRETTY=false

# ---------- HTTP client gọi service khác ----------
# Timeout mỗi lần gọi (ms). Lưu ý: .env gốc ghi 5000, template mặc định 3000
HTTP_TIMEOUT_MS=3000
# Số lần thử lại tối đa (chỉ GET/lệnh idempotent)
HTTP_MAX_RETRIES=2

# ---------- Swagger / Idempotency ----------
# Bật Swagger ở /api/docs (nên tắt ở production)
SWAGGER_ENABLED=true
# Thời gian lưu kết quả Idempotency-Key trong Redis (giây): 24 giờ
IDEMPOTENCY_TTL_SECONDS=86400

# =============================================================================
# TÙY CHỌN: bỏ comment để BẬT module tương ứng (mặc định tắt).
# =============================================================================

# PostgreSQL (TypeORM). Laptop dùng cổng 5433; trong Docker dùng host postgres cổng 5432.
# Thay user/DB bằng của service mình (identity_db, listing_db, rental_db, payment_db).
# DATABASE_URL=postgres://identity_user:change_me_identity@localhost:5433/identity_db

# Redis (có mật khẩu). Cần cho @Idempotent().
# REDIS_URL=redis://:change_me_redis@localhost:6379

# RabbitMQ (outbox/inbox): BẮT BUỘC kèm DATABASE_URL và migration CreateMessagingTables.
# vhost "/" phải viết %2F.
# RABBITMQ_URL=amqp://rabbit_admin:change_me_rabbitmq@localhost:5672/%2F
# Queue service này đọc (xem infra/rabbitmq/definitions.json). Bỏ trống = chỉ publish.
# RABBITMQ_QUEUE=rental.payment-events
# RABBITMQ_EXCHANGE=domain.events
# RABBITMQ_PREFETCH=10
# Thử lại tối đa bao nhiêu lần trước khi đẩy message vào <queue>.dlq
# RABBITMQ_MAX_RETRIES=3
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH_SIZE=50
# Chỉ dùng khi test: false = event ghi vào outbox nhưng KHÔNG gửi lên RabbitMQ
# OUTBOX_RELAY_ENABLED=true

# Object storage S3 (Cloudflare R2, xem project-knowledge/decisions/0016). Bắt buộc kèm S3_ACCESS_KEY, S3_SECRET_KEY.
# Khóa thật chỉ để ở .env (không commit). Token R2 quyền Object Read & Write trên bucket cần dùng.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY=<Access Key ID>
# S3_SECRET_KEY=<Secret Access Key>
# Bucket CÓ SẴN (tạo tay trên dashboard R2, service không tự tạo), cách nhau dấu phẩy
# S3_BUCKETS=listing-images
# Chỉ đặt khi host ký vào presigned URL khác S3_ENDPOINT (R2: để trống)
# S3_PUBLIC_ENDPOINT=
# S3_PRESIGN_TTL_SECONDS=900

# JWT: cấu hình MỘT trong ba, ưu tiên theo thứ tự dưới đây. Không cấu hình thì mọi route
# không gắn @Public() sẽ trả 503 AUTH_NOT_CONFIGURED.
# 1) Khóa công khai dạng PEM (xuống dòng viết \n), RS256
# JWT_PUBLIC_KEY=
# 2) Đường dẫn file khóa công khai, RS256 (đường dẫn tính từ thư mục service)
# JWT_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
# 3) Bí mật dùng chung HS256 (CHỈ dev)
# JWT_SECRET=change_me_jwt_secret_dev_only
# Issuer mong đợi trong token (bỏ trống thì không kiểm tra)
# JWT_ISSUER=realestate-identity
