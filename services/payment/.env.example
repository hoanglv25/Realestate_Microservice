# =============================================================================
# .env.example của service. Sao chép thành .env (KHÔNG commit .env):
#   Copy-Item .env.example .env      (`pnpm dev` tự làm việc này nếu chưa có .env)
# Giá trị mẫu chỉ dùng cho dev local, khớp với giá trị mẫu của .env gốc repo.
# Thiếu biến bắt buộc (SERVICE_NAME) hoặc sai định dạng thì service dừng ngay khi khởi động.
# =============================================================================

# ---------- Tối thiểu (luôn cần) ----------
# Môi trường chạy: development | test | production
NODE_ENV=development
# Cổng HTTP của payment-service (khớp PAYMENT_PORT trong .env gốc)
PORT=3004
# Tên service, xuất hiện trong log, /health và tài liệu Swagger (BẮT BUỘC, không có mặc định)
SERVICE_NAME=payment
# Mức log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# true: log màu dễ đọc bằng pino-pretty (chỉ dev); false: JSON một dòng ra stdout
LOG_PRETTY=false

# ---------- HTTP client gọi service khác ----------
# Timeout mỗi lần gọi (ms). Lưu ý: .env gốc ghi 5000, template mặc định 3000
HTTP_TIMEOUT_MS=3000
# Số lần thử lại tối đa (chỉ GET/lệnh idempotent)
HTTP_MAX_RETRIES=2

# ---------- Swagger / Idempotency ----------
# Bật Swagger ở /api/docs (nên tắt ở production)
SWAGGER_ENABLED=true
# Idempotency-Key (T3.6): tạo lệnh rút, hoàn tất lệnh chi. Lưu ở Redis (REDIS_URL bên dưới)
IDEMPOTENCY_TTL_SECONDS=86400

# =============================================================================
# Cấu hình RIÊNG của payment-service (RE.PAYMENT/API_Spec.md §5)
# =============================================================================

# ---------- PostgreSQL (BẮT BUỘC) ----------
# Laptop dùng cổng 5433; trong Docker dùng host postgres cổng 5432.
# Chạy migration một lần: pnpm --filter @realestate/payment migration:run
DATABASE_URL=postgres://payment_user:change_me_payment@localhost:5433/payment_db

# ---------- RabbitMQ (BẮT BUỘC từ T3.4a): webhook phát payment.deposited qua outbox. Chỉ phát, không nghe ----------
RABBITMQ_URL=amqp://rabbit_admin:change_me_rabbitmq@localhost:5672/

# ---------- payOS (BẮT BUỘC): khóa của kênh thanh toán trên my.payos.vn ----------
# payOS không có môi trường thử riêng: giao dịch là thật, khi thử dùng số tiền nhỏ (chốt 2026-11-22)
# Giá trị thật CHỈ ghi trong .env (không commit), security-policy.md §1
PAYOS_CLIENT_ID=22a64e81-bc5e-46df-a8c6-d7d1db3d94fc
PAYOS_API_KEY=5ff6af5f-e46e-4069-b189-594e668d86bf
PAYOS_CHECKSUM_KEY=9d14bf8d13c1bf076bd6b1c7dcc037fb74dd4e57ed9a8feeaf8c4e63b147e361
# Trang của giao diện Next.js; returnUrl KHÔNG phải bằng chứng thanh toán (chỉ webhook là bằng chứng)
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
# Timeout mỗi lần gọi payOS (ms). Phải < PAYMENT_CALL_TIMEOUT_MS của rental (3000). Không retry tạo link
PAYOS_TIMEOUT_MS=2500

# ---------- JWT RS256 (BẮT BUỘC): payment chỉ KIỂM token, không ký ----------
# Tạo khóa một lần ở gốc repo: pnpm keys:generate. Đường dẫn tính từ thư mục service.
JWT_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
# Hoặc dán PEM thay cho đường dẫn (xuống dòng viết \n), đặt MỘT trong hai: JWT_PUBLIC_KEY=
# Issuer mong đợi trong token (khớp JWT_ISSUER của identity)
JWT_ISSUER=realestate-identity

# =============================================================================
# Payout: hoàn, rút, chứng từ (RE.PAYOUT/API_Spec.md §6, T3.6)
# =============================================================================

# ---------- Redis (BẮT BUỘC từ T3.6): Idempotency-Key của tạo lệnh rút, hoàn tất lệnh chi ----------
# Dùng CÙNG mật khẩu với REDIS_PASSWORD trong .env gốc
REDIS_URL=redis://:change_me_redis@localhost:6379

# ---------- Object storage S3 (BẮT BUỘC từ T3.6): chứng từ chuyển khoản (BR-17) ----------
# Cloudflare R2 (project-knowledge/decisions/0016). Dùng CÙNG giá trị với .env gốc repo.
# Thay ACCOUNT_ID và hai khóa bằng giá trị thật (token R2 Object Read & Write); khóa thật không commit.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=ACCESS_KEY_ID
S3_SECRET_KEY=SECRET_ACCESS_KEY
# Phải có payment-proofs (tạo sẵn trên R2, service không tự tạo). Các bucket cách nhau dấu phẩy
S3_BUCKETS=payment-proofs
# Cỡ tối đa một tệp chứng từ (byte), mặc định 5 MB. Loại nhận: image/jpeg, image/png, application/pdf
# RECEIPT_MAX_BYTES=5242880

# ---------- Gọi service khác (BẮT BUỘC từ T3.6) ----------
# rental: điều kiện rút tiền; identity: tài khoản nhận tiền. Trong Docker compose tự đặt http://rental:3003...
INTERNAL_RENTAL_URL=http://localhost:3003
INTERNAL_IDENTITY_URL=http://localhost:3001
